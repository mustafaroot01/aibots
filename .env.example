# قناة التلجرام العامة (بدون @)
TG_CHANNEL=Diyala_jobs

# مفتاح Claude API — من https://console.anthropic.com
ANTHROPIC_API_KEY=

# مزوّد الذكاء الاصطناعي: claude أو gemini أو rules
AI_PROVIDER=gemini

# مفتاح Gemini — من https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# موديل الفلترة والاستخراج
CLAUDE_MODEL=claude-opus-5
# مستوى الجهد: low أرخص وأسرع، medium/high أدق
CLAUDE_EFFORT=low

# مسار قاعدة البيانات
DB_PATH=./data/jobs.db

# كل كم ثانية يفحص القناة
POLL_SECONDS=180

# مفتاح تشفير الأسرار المخزّنة بقاعدة البيانات (توكن البوت)
SECRET_KEY=ولّد واحد بأمر: openssl rand -hex 32

# توكن لوحة الإدارة /admin
ADMIN_TOKEN=غيّرني-الى-كلمة-سر-قوية

# قناتك على تلجرام (تظهر بالموقع للزوار)
BRAND_CHANNEL=diyalajob

# اسم الموقع
SITE_NAME=وظائف ديالى
SITE_URL=https://example.com

# ——— النشر بقناتك الخاصة (تقدر تضبطهن من لوحة التحكم بدل هنا) ———
# توكن البوت من @BotFather — لازم يكون أدمن بقناتك
TG_BOT_TOKEN=
# قناة النشر: @MyChannel أو -1001234567890
TG_PUBLISH_CHANNEL=
